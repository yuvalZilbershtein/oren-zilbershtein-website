---
import { attribution, getPlaces, getTestimonials } from '../lib/content';
import Icon from './Icon.astro';
import TestimonialCard from './TestimonialCard.astro';

const places = new Map((await getPlaces()).map((p) => [p.slug, p]));
const testimonials = (await getTestimonials()).map((t) => {
  const place = t.place ? places.get(t.place) : undefined;
  return {
    quote: t.quote,
    ...attribution(t),
    logo: place?.logo,
    link: place ? `/work/${place.slug}/` : undefined,
  };
});
---

{
  testimonials.length === 1 && (
    <section class="section section--dark" id="testimonials">
      <div class="container">
        <p class="eyebrow eyebrow--center" data-reveal>
          Kind words
        </p>
        <TestimonialCard {...testimonials[0]} solo />
      </div>
    </section>
  )
}

{
  testimonials.length > 1 && (
    <section class="section section--dark" id="testimonials">
      <div class="container t-head">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Testimonials</p>
          <h2 class="h2">
            Kind words from <em>kitchens I’ve worked with</em>
          </h2>
        </div>
        <div class="t-nav" data-reveal>
          <button type="button" data-dir="-1" aria-label="Previous testimonial">
            <Icon name="arrow-left" />
          </button>
          <button type="button" data-dir="1" aria-label="Next testimonial">
            <Icon name="arrow-right" />
          </button>
        </div>
      </div>

      <div class="t-track" role="region" aria-label="Testimonials" tabindex="0" data-reveal>
        {testimonials.map((t) => (
          <TestimonialCard {...t} />
        ))}
      </div>
    </section>
  )
}

<script>
  const track = document.querySelector<HTMLElement>('.t-track');
  const buttons = document.querySelectorAll<HTMLButtonElement>('.t-nav button');

  if (track) {
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      buttons[0].disabled = track.scrollLeft <= 2;
      buttons[1].disabled = track.scrollLeft >= max;
    };
    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const card = track.querySelector<HTMLElement>('.t-card');
        const step = (card?.offsetWidth ?? 400) + parseFloat(getComputedStyle(track).columnGap || '0');
        track.scrollBy({ left: step * Number(button.dataset.dir), behavior: 'smooth' });
      }),
    );
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }

</script>
